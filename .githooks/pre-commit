#!/usr/bin/env bash
# Block commits that add secrets. Enable once per clone:
#   git config core.hooksPath .githooks
if command -v gitleaks >/dev/null 2>&1; then
  exec gitleaks git --pre-commit --staged --redact --no-banner
fi
echo "pre-commit: gitleaks not installed (brew install gitleaks); skipping secret scan" >&2
