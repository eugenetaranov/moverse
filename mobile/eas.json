{
  "cli": { "version": ">= 13.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "API_URL": "http://192.168.1.10:3000", "SUPABASE_URL": "http://192.168.1.10:54321" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "API_URL": "https://staging-moverse.vercel.app" }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "env": { "API_URL": "https://moverse-chi.vercel.app" }
    }
  }
}
